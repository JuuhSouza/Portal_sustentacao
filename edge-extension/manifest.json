{
  "manifest_version": 3,
  "name": "Guia de Chamados Overlay",
  "version": "0.1.0",
  "description": "Mostra um painel de guia de chamados sobre qualquer site.",
  "host_permissions": ["<all_urls>"],
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Guia de Chamados"
  }
}
